# Copy to .env and adjust. Never commit .env.
#
# This file holds DEPLOYMENT configuration only. Business rules - grading
# rubrics, thresholds, deduction tables, field weights - live in config/*.yaml
# where they are versioned, reviewable by non-engineers, and changeable without
# a deploy. Secrets never go in YAML; business rules never go here.

# ---------------------------------------------------------------------------
# Environment
# ---------------------------------------------------------------------------
ENVIRONMENT=dev                  # dev | ci | staging | prod
DEBUG=true
LOG_LEVEL=INFO
LOG_FORMAT=console               # console for local, json everywhere else

# Shows a non-dismissible warning banner and labels every generated report.
# Defaults to TRUE so a forgotten variable errs toward over-disclosure rather
# than passing synthetic output off as real. The API refuses to start in `prod`
# with this enabled.
SYNTHETIC_DATA_MODE=true

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://caready:caready@localhost:5432/caready
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_ECHO=false

# ---------------------------------------------------------------------------
# Queue
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
RQ_QUEUE_DEFAULT=caready-default
RQ_QUEUE_SLOW=caready-slow
RQ_JOB_TIMEOUT_SECONDS=900

# ---------------------------------------------------------------------------
# Object storage
# ---------------------------------------------------------------------------
# MinIO locally, S3 in production. Leave S3_ENDPOINT_URL empty for real S3.
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=caready
S3_SECRET_ACCESS_KEY=caready-dev-secret
S3_BUCKET_PHOTOS=caready-photos
S3_BUCKET_EXPORTS=caready-exports
S3_USE_PATH_STYLE=true
# Photos are served only through short-lived signed URLs. Buckets are private.
S3_SIGNED_URL_TTL_SECONDS=300

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# The API refuses to start in `prod` while these are the development defaults.
# Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=1209600

# argon2id. Raising these is safe: existing hashes are upgraded transparently
# on the user's next successful login.
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST_KIB=65536
ARGON2_PARALLELISM=4

# ---------------------------------------------------------------------------
# PII encryption (§10, UU PDP No. 27/2022)
# ---------------------------------------------------------------------------
# Comma-separated. The FIRST key encrypts; ALL keys are tried on decrypt, which
# is what makes rotation possible without downtime:
#   1. prepend the new key   2. run the re-encryption job   3. drop the old key
#
# Generate: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
# In production these must come from a secrets manager, not from a file.
PII_ENCRYPTION_KEYS=dev-only-insecure-passphrase-change-me

# ---------------------------------------------------------------------------
# MLflow
# ---------------------------------------------------------------------------
MLFLOW_TRACKING_URI=http://localhost:5500
MLFLOW_EXPERIMENT=caready-pricing

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
API_CORS_ORIGINS=http://localhost:3000
API_RATE_LIMIT_PER_MINUTE=300

# ---------------------------------------------------------------------------
# Providers (M2+)
# ---------------------------------------------------------------------------
# Implementation choice lives in config/providers.yaml; credentials live here.
# Defaults are the deterministic stubs - nothing reaches an external service.
#
# The cloud OCR adapter sends STNK images off-premises and therefore requires
# config/pdp.yaml `third_party.allow_raw_pii_to_external_providers` plus a
# recorded DPA reference. The local PaddleOCR adapter has no such requirement.
# OCR_CLOUD_ENDPOINT=
# OCR_CLOUD_API_KEY=
# OCR_CLOUD_PROCESSOR_ID=

# VISION_VLM_MODEL=
# VISION_VLM_API_KEY=
# VISION_YOLO_WEIGHTS=

# Adapter breakage must page someone. Silently stale price data corrupts the
# residual-value anchor that every prediction depends on.
# PRICE_INGESTION_ALERT_WEBHOOK=

# ---------------------------------------------------------------------------
# Web (apps/web reads NEXT_PUBLIC_* at build time)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
